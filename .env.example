# Telegram Bot Token (get it from @BotFather)
BOT_TOKEN=your_bot_token_here

# Proxy settings (required if api.telegram.org is blocked in your region)
# Supported proxy types: socks5, socks4, http, https
# Leave PROXY_URL empty to run without a proxy
PROXY_URL=socks5://user:password@proxy_host:proxy_port

# Examples:
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=socks5://user:pass@proxy.example.com:1080
# PROXY_URL=http://proxy.example.com:8080
